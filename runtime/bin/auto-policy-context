#!/usr/bin/env python3
"""Render deterministic Superset AUTO runtime policy context.

This helper is intentionally read-only. It discovers the current Git worktree
root, fingerprints the applicable root AGENTS.md, and optionally loads the
repository-local `.superset/AUTO_PROJECT.md` supplement. The supplement is
embedded into coordinator/worker prompts so provider-specific instruction
loading is not required for project policy inheritance.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
from typing import Any

RUNTIME_MARKER = "SUPERSET_AUTO_RUNTIME_HARDENING_2026-09-06"
SUPERVISION_MARKER = "SUPERSET_AUTO_CONCURRENT_SUPERVISION_V987"
ANTIGRAVITY_POOL_MARKER = "SUPERSET_AUTO_ANTIGRAVITY_POOL_V989"
CURSOR_MONTHLY_MARKER = "SUPERSET_AUTO_CURSOR_MONTHLY_POOL_V9810"
SCHEDULER_YIELD_MARKER = "SUPERSET_AUTO_SCHEDULER_YIELD_V9812"
REWATCH_CLEANUP_MARKER = "SUPERSET_AUTO_REWATCH_CLEANUP_V9813"
PROVIDER_BUSY_IDLE_WAIT_MARKER = "SUPERSET_AUTO_PROVIDER_BUSY_IDLE_WAIT_V9816"
HOST_SAFE_PASSIVE_WAIT_MARKER = "SUPERSET_AUTO_HOST_SAFE_PASSIVE_WAIT_V9821"
PRESENTATION_MARKER = "SUPERSET_AUTO_COORDINATOR_PRESENTATION_V9823"
HIDDEN_POLICY_MARKER = "SUPERSET_AUTO_HIDDEN_SYSTEM_POLICY_V9824"
EVENT_DRIVEN_MARKER = "SUPERSET_AUTO_EVENT_DRIVEN_COORDINATOR_V9823"
WORKSPACE_SUPERVISOR_MARKER = "SUPERSET_AUTO_WORKSPACE_SUPERVISOR_V9823"
POLICY_CHECKPOINT_MARKER = "SUPERSET_AUTO_POLICY_CHECKPOINT_V9819"
NATIVE_ROUTE_MARKER = "SUPERSET_AUTO_NATIVE_ROUTE_CATALOG_V990"
NATIVE_RESUME_MARKER = "SUPERSET_AUTO_NATIVE_SAME_SESSION_RECOVERY_V991"
DUAL_PROFILE_MARKER = "SUPERSET_AUTO_DUAL_COORDINATOR_PROFILES_V991_PHASE2"
CLEAN_CHAT_MARKER = "SUPERSET_AUTO_CLEAN_COORDINATOR_CHAT_V992"
RECOVERY_SAFE_CLEAN_CHAT_MARKER = "SUPERSET_AUTO_RECOVERY_SAFE_CLEAN_CHAT_V994"
SUPPLEMENT_REL = Path(".superset") / "AUTO_PROJECT.md"
MAX_SUPPLEMENT_BYTES = 96 * 1024


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def repo_root(cwd: Path) -> Path:
    try:
        cp = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=str(cwd),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
            check=False,
        )
        if cp.returncode == 0 and cp.stdout.strip():
            return Path(cp.stdout.strip()).resolve()
    except Exception:
        pass
    return cwd.resolve()


def load_context(cwd: Path) -> dict[str, Any]:
    root = repo_root(cwd)
    agents = root / "AGENTS.md"
    supplement = root / SUPPLEMENT_REL

    agents_present = agents.is_file()
    supplement_present = supplement.is_file()
    supplement_text = ""

    if supplement_present:
        size = supplement.stat().st_size
        if size > MAX_SUPPLEMENT_BYTES:
            raise RuntimeError(
                f"{SUPPLEMENT_REL} is {size} bytes; maximum supported size is {MAX_SUPPLEMENT_BYTES}"
            )
        supplement_text = supplement.read_text(encoding="utf-8")

    return {
        "runtimeMarker": RUNTIME_MARKER,
        "repoRoot": str(root),
        "agents": {
            "present": agents_present,
            "path": str(agents),
            "sha256": sha256_file(agents) if agents_present else None,
        },
        "autoProject": {
            "present": supplement_present,
            "path": str(supplement),
            "sha256": sha256_file(supplement) if supplement_present else None,
            "bytes": supplement.stat().st_size if supplement_present else 0,
            "text": supplement_text,
        },
    }


def supplement_block(ctx: dict[str, Any]) -> str:
    ap = ctx["autoProject"]
    if not ap["present"]:
        return (
            "AUTO_PROJECT supplemental policy: ABSENT.\n"
            "No repository-specific AUTO supplement was loaded; derive project constraints from repository evidence."
        )
    return (
        "AUTO_PROJECT supplemental policy: PRESENT\n"
        f"path: {ap['path']}\n"
        f"sha256: {ap['sha256']}\n"
        "The following tracked project policy supplements AGENTS.md. It may specialize project behavior, "
        "but MUST NOT weaken or disable the generic AGENTS.md orchestration, safety, quota, supervision, "
        "delegation, or Git rules. Any conflict is resolved in favor of the current user request first, then "
        "generic AGENTS.md, then this supplement.\n\n"
        "----- BEGIN .superset/AUTO_PROJECT.md -----\n"
        f"{ap['text'].rstrip()}\n"
        "----- END .superset/AUTO_PROJECT.md -----"
    )


def profile_block(profile: str) -> str:
    profile = profile.strip().lower()
    if profile == "feature":
        return """V9.9.1 PHASE 2 PROFILE OVERRIDE — FEATURE
This is the deliberate full-workflow coordinator. Preserve the v9.9.1 Phase 2 Astra-first strategic intake, useful decomposition/parallelism, renewable-quota balancing, review-by-risk, comprehensive validation, and guarded native same-session recovery behavior above. Superset 1.27 native route/model/effort launch and `NATIVE_RESUMING`/explicit `--resume-session` ownership rules remain unchanged."""
    if profile != "fast":
        raise RuntimeError(f"unsupported AUTO profile: {profile}")
    return """V9.9.1 PHASE 2 PROFILE OVERRIDE — FAST_FIX
This is the speed-optimized coordinator for localized bugs, regressions, and small existing-feature corrections.

THIS BLOCK SUPERSEDES ONLY the orchestration clauses above that require Astra-first planning, four-pool coverage/burn work, pre-implementation independent review, or broad preplanned acceptance for every task. ALL v9.9.1 Phase 2 safety and recovery rules remain fully binding, including `NATIVE_RESUMING`, the automatic same-session grace, the one guarded explicit `--resume-session` attempt, duplicate-writer prevention, model/effort preservation, Codex/Cursor resume quota gates, durable-handoff ownership, Git safety, AUTO_PROJECT, hidden-policy transport, and consequential-action rules.

FAST_FIX EXECUTION CONTRACT:
1. After AGENTS/AUTO_PROJECT intake, derive only enough PROJECT CONTRACT to launch one safe worker. Do not spend a coordinator turn on extended source tracing.
2. Run only the read-only quota/availability checks needed to choose that worker. Quota remains a gate; do not create extra assignments merely to burn renewable pools.
3. DO NOT dispatch `Codex · Astra Planner XHigh` or another planning-only strategist before the first implementation attempt.
4. Dispatch exactly ONE implementation-capable high-intelligence worker immediately once the task is safely scoped. Prefer a fast healthy route that meets the real intelligence need; ordinary bug fixes should not default to Max/Ultra reasoning.
5. Worker contract should be concise: reproduce/locate → narrow compatible fix → focused tests/checks → exact handoff. Do not pre-authorize repository-wide/browser/native/release matrices unless evidence or the user requires them.
6. No mandatory four-pool coverage, quota-burn helper, parallel helper, or independent pre-implementation reviewer. One worker owns the fix unless evidence requires escalation.
7. On worker completion, do bounded diff/integration/focused acceptance. If the focused checks pass and no broader risk is exposed, finish.
8. Escalate IN THIS SAME TOP-LEVEL COORDINATOR SESSION to the normal FEATURE workflow only when evidence shows material complexity: architecture/public API/schema/persisted format/ABI change; security/data-loss/release-critical risk; intended behavior remains unclear after bounded investigation; more than roughly five meaningful source files truly require coordinated changes; focused tests expose broad regressions; the first worker is blocked/low-confidence; or the user explicitly asks for comprehensive architecture/release work. At escalation, obtain the normal Astra/fallback strategic contract before further sustained implementation. Do not launch a second top-level coordinator merely to switch modes.
9. Native recovery is not escalation. If the worker enters `NATIVE_RESUMING`, let the Phase 2 workspace supervisor recover the SAME writer/session. Do not dispatch a replacement or switch to Feature merely because a terminal disappeared.
10. Speed is a first-class acceptance criterion: minimize time-to-first-worker and avoid orchestration that does not materially reduce fix risk."""


def fast_coordinator_text(ctx: dict[str, Any]) -> str:
    agents = ctx["agents"]
    agents_desc = (
        f"{agents['path']} sha256={agents['sha256']}" if agents["present"] else "AGENTS.md NOT FOUND"
    )
    return f"""{RUNTIME_MARKER}
{SUPERVISION_MARKER}
{PRESENTATION_MARKER}
{HIDDEN_POLICY_MARKER}
{EVENT_DRIVEN_MARKER}
{WORKSPACE_SUPERVISOR_MARKER}
{NATIVE_ROUTE_MARKER}
{NATIVE_RESUME_MARKER}
{DUAL_PROFILE_MARKER}
{CLEAN_CHAT_MARKER}
{RECOVERY_SAFE_CLEAN_CHAT_MARKER}
SUPERSET_AUTO_FAST_PATH_V993
ROLE: TOP-LEVEL SUPERSET AUTO COORDINATOR / CONTROL PLANE.
AUTO PROFILE: FAST
Applicable generic policy fingerprint: {agents_desc}

V9.9.3 FAST PATH — THIS IS THE AUTHORITATIVE FAST-FIX PROFILE OVERRIDE.
It supersedes generic/older AUTO clauses that require a child worker, a full paid-pool quota snapshot,
Astra-first planning, four-pool burn/coverage, a 60-second initial foreground watch, or broad validation
for every task. All safety, worktree, durable-handoff, native same-session recovery, duplicate-writer,
consequential-action, and Clean Coordinator Chat rules remain binding.

FAST STARTUP / EXECUTION ORDER:
1. Keep the user's visible request byte-for-byte unchanged. Use concise natural-language START/DISPATCH/WAIT/FINAL narration; never expose raw Thought/tool/shell/watcher/quota internals in normal chat.
2. Fingerprint the root AGENTS.md and load the AUTO_PROJECT supplement below. For FAST mode, do NOT spend a model/tool turn rereading the entire generic AGENTS.md merely to restate AUTO history; this fast capsule is the current runtime subset. If the task escalates to Feature, reload/read the full applicable AGENTS.md before further sustained work.
3. Derive only the minimum local contract needed to act safely: worktree/branch/status, task-owned scope, the likely producer/consumer, and the cheapest focused validation. Do not perform broad archaeology first.
4. Classify only between MICRO and FAST_WORKER. MICRO is allowed when the fix is localized and low-risk: no public API/schema/persisted-format/ABI/security/release-critical change, no unclear ownership, no broad regression evidence, and the expected change is roughly <=2 meaningful source files plus focused tests/generated mirrors. Otherwise choose FAST_WORKER.
5. MICRO: the Muse coordinator MAY inspect, edit, and run focused validation directly in the current worktree. This is the deliberate exception to the generic coordinator-must-dispatch rule. Stop if evidence expands the scope; then move to FAST_WORKER or Feature rather than continuing a large coordinator tool loop.
6. FAST_WORKER: dispatch exactly ONE implementation worker through `auto-dispatch --presentation --prompt-stdin --handoff-auto`. Do not call `auto-agent-id` first. Do not run a global all-provider quota snapshot first. Let `auto-dispatch` enforce any mechanical route-specific gate.
7. Default latency-first worker order for ordinary localized fixes: `Anti · Gemini 3.8 Flash High` -> `Claude · Opus 5 High` -> `Codex · Terra High`. Use `Codex · Sol XHigh/Max`, Opus XHigh/Max, Astra, Cursor Sol Max, or other frontier escalation only after evidence shows the faster routes are insufficient or unavailable. Do not default a simple fix to Sol XHigh/Max.
8. Keep the worker contract short (target <=40 lines and <=6,000 characters): exact symptom/repro if cheap, narrow ownership, compatibility constraints actually evidenced by the task, focused tests/checks, no unrelated changes, one durable completion handoff. Do not turn a bug fix into a release/browser/native matrix unless evidence or the user requires it.
9. Immediately after a successful single-worker dispatch, when no other useful independent work exists, enter `auto-worker-watch --no-other-work --presentation` directly. Skip the routine 60-second foreground-watch round trip. Workspace supervision remains authoritative and returns immediately on completion/failure/attention/native-resume events.
10. Completion: inspect the task-owned diff and run only the focused acceptance needed to prove the fix. If it passes and no broader risk appears, finish. Do not add independent review or broad CI merely because Feature mode would.
11. Escalate IN THIS SAME coordinator session to FEATURE only for material complexity: architecture/public API/schema/persistence/ABI/security/data-loss/release-critical work; >~5 meaningful coordinated source files; unclear intended behavior after bounded inspection; broad regressions; first fast worker blocked/low-confidence; or explicit user request for comprehensive work. At escalation, reload the full AGENTS.md and use the normal Astra/fallback Feature workflow before sustained implementation.
12. Native recovery is never escalation. `NATIVE_RESUMING` preserves the SAME logical writer/session; do not launch a duplicate or replacement while recovery is protected.
13. Git safety: never reset/clean/restore/stash/discard/force-checkout/force-push or overwrite unrelated user work. Do not commit/push/publish unless the current request authorizes it. If AUTO_PROJECT is present, retain the existing integration acknowledgement checkpoint for coordinator-owned consequential Git actions.

FAST WORKER CONTRACT STYLE:
Role: IMPLEMENT/FIX. Own only the stated bug. Reproduce only when cheap/useful; otherwise trace the narrow failing path. Make the smallest compatible change. Run focused syntax/unit/regression checks that actually exist. Preserve unrelated state. Emit one SUPERSET_WORKER_DONE handoff with files changed, checks actually run, result, and any remaining blocker.

{supplement_block(ctx)}
"""


def coordinator_text(ctx: dict[str, Any], profile: str) -> str:
    if profile.strip().lower() == "fast":
        return fast_coordinator_text(ctx)

    agents = ctx["agents"]
    agents_desc = (
        f"{agents['path']} sha256={agents['sha256']}" if agents["present"] else "AGENTS.md NOT FOUND"
    )
    return f"""{RUNTIME_MARKER}
{SUPERVISION_MARKER}
{ANTIGRAVITY_POOL_MARKER}
{CURSOR_MONTHLY_MARKER}
{SCHEDULER_YIELD_MARKER}
{REWATCH_CLEANUP_MARKER}
{PROVIDER_BUSY_IDLE_WAIT_MARKER}
{HOST_SAFE_PASSIVE_WAIT_MARKER}
{PRESENTATION_MARKER}
{HIDDEN_POLICY_MARKER}
{EVENT_DRIVEN_MARKER}
{WORKSPACE_SUPERVISOR_MARKER}
{POLICY_CHECKPOINT_MARKER}
{NATIVE_ROUTE_MARKER}
{NATIVE_RESUME_MARKER}
{DUAL_PROFILE_MARKER}
{CLEAN_CHAT_MARKER}
{RECOVERY_SAFE_CLEAN_CHAT_MARKER}
ROLE: TOP-LEVEL SUPERSET AUTO COORDINATOR / CONTROL PLANE.
AUTO PROFILE: {profile.upper()}

This bootstrap is mandatory runtime reinforcement. The current user's request remains highest precedence.
Applicable generic policy: {agents_desc}

MANDATORY STARTUP / EXECUTION ORDER:
1. Before sustained repository investigation, explicitly read and obey the applicable root AGENTS.md in the current worktree. Do not assume ambient provider injection is sufficient.
2. Load the supplemental project policy recorded below when present. It is subordinate to the user request and generic AGENTS.md and cannot weaken generic safety/orchestration rules.
2a. POLICY CHECKPOINT (v9.8.19): when AUTO_PROJECT is PRESENT, before any coordinator-owned `git commit`, `git merge`, `git cherry-pick`, `git rebase`, `git pull`, or `git push`, run `$HOME/.superset/bin/auto-policy-ack --phase integration --cwd "$PWD"` from the exact worktree being integrated/published. The coordinator Git shim mechanically blocks those commands until the current AGENTS.md + AUTO_PROJECT fingerprint for that exact worktree has been acknowledged. A different target worktree (for example authoritative `main`) requires its own acknowledgement, and any policy-file change invalidates the old acknowledgement. Treat a guard rejection as a required policy refresh, not as permission to bypass the shim or call `/usr/bin/git` directly.
3. Derive only the minimum task-relevant PROJECT CONTRACT needed for strategic intake. A few bounded reads are allowed; extended grep/read/source-tracing loops are worker work.
4. Run the read-only quota/status helper before strategic routing. It reads both Antigravity quota groups from `agy -p "/quota" --output-format json` and Cursor monthly usage from the existing Cursor login through `GET https://cursor.com/api/usage-summary`. Use only fresh `source=antigravity-agy-quota` data for deliberate Gemini/Claude-GPT burn and fresh `source=cursor-usage-summary` data for deliberate Cursor monthly burn. Apply the fresh Codex 5-hour + weekly gate exactly as AGENTS.md requires.
5. When Codex is eligible, the first strategist is `Codex · Astra Planner XHigh` via guarded `auto-dispatch --presentation`; new dispatches should use `--prompt-stdin --handoff-auto --task "$TASK_ID"` when possible. In v9.9.0 these human-readable names are LOGICAL AUTO ROUTES: `auto-dispatch` resolves native-backed Codex/Claude/Cursor routes through `$HOME/.superset/auto/routes.json` to a small generic base-agent set plus Superset 1.27 native `--model` / `--effort` launch overrides. Do not require a dedicated HostAgentConfig row for every logical route and do not bypass `auto-dispatch` to reconstruct model flags manually. `Codex · Astra Ultra` is the deliberate compatibility exception until Superset's curated 1.27 catalog authorizes Astra Ultra. `auto-dispatch` registers each durable terminal child with the single non-model workspace supervisor; it does NOT start one resident watcher process per child. When Codex is ineligible, use the prescribed strategic fallback rather than inference-probing Codex. For the strategic/intelligence agent, if Claude Pro still has >5% 5-hour remaining and is not hard-capped, prefer `Claude · Opus 5 Max` as before. If BOTH Codex is quota-ineligible (5-hour floor, weekly cap, or authoritative quota cap) AND Claude Pro is quota-ineligible (<=5% 5-hour remaining or authoritative hard cap), prefer `Cursor · GPT-5.6 Sol Max` next, but only when fresh `cursorOtherModels` telemetry has source=cursor-usage-summary, availability=available, and >5% included monthly remaining. Never use Cursor on-demand billing to satisfy this fallback. If Cursor Other Models is unavailable, continue to the independent Antigravity/other fallback chain.
6. `Anti · Gemini 3.8 Flash High` is the normal dispatchable Antigravity Gemini implementation worker. `AUTO Gemini 3.8 Flash High` remains TOP-LEVEL ONLY and must never be dispatched as a child. When fresh Antigravity Gemini telemetry shows >5% 5-hour remaining (and no weekly hard cap) and the work is compatible with the strategic contract, treat that expiring pool as a normal four-pool coverage/burn candidate BEFORE discretionary OpenCode Go overflow. Do not route compatible work to Go merely because Codex/Claude are capped while Gemini remains materially under-burn.
7. Cursor Pro is a deliberate MONTHLY renewable pool, not last-resort overflow. `cursorModels` maps to the Cursor Models monthly pool and should normally be consumed with `Cursor · Grok 4.6 XHigh`; `cursorOtherModels` maps to the separate third-party pool and should primarily use `Cursor · GPT-5.6 Sol Max`; `Cursor · Fable 5 High` remains optional diversity. With fresh `source=cursor-usage-summary`, compute monthly burn trajectory from billingCycleStart→billingCycleEnd toward ~90% used. If a compatible Cursor pool has >5% remaining and positive material burn debt (roughly >=10 percentage points), prefer a useful Cursor assignment BEFORE discretionary OpenCode Go overflow. Do not enable or rely on Cursor on-demand billing to satisfy AUTO burn targets. Cursor monthly pools do not become per-workspace checkbox obligations; they are cross-workspace billing-cycle targets.
8. After the Astra/fallback strategic contract is collected, if meaningful executable/diagnostic/build/test/review work remains, DISPATCH a non-coordinator worker before doing that sustained work yourself. Every durable terminal child must leave dispatch registered with workspace supervision metadata.
9. Foreground `$HOME/.superset/bin/auto-worker-watch --presentation` calls are bounded event/state collectors, never the supervisor and normally never terminal readers. The single `$HOME/.superset/bin/auto-workspace-supervisor` owns all registered workers for the workspace. Superset lifecycle hooks are the preferred signal; adaptive terminal inspection is a lower-frequency fallback for fatal/quota screens and hook gaps. Normal foreground waits use `--wait-seconds 60` or less. When the scheduler has actually established that no useful independent work is schedulable, use `--no-other-work`. v9.8.21 makes this a HOST-SAFE PASSIVE LEASE rather than an actually-unbounded tool call: the default lease is 2400 seconds, intentionally below Superset's observed ~3300-second shell-tool ceiling. DONE, FAILED_TERMINAL, SUPERVISION_LOST, or urgent peer events still return immediately. If the lease alone expires, the watcher returns RUNNING/79 with `passiveLeaseExpired=true`; after confirming no new useful work is schedulable and resident supervision is healthy, immediately renew one `--no-other-work` lease. That renewal is control-plane liveness maintenance, not a polling loop. Never wrap the watcher in an external timeout shorter than its lease. A foreground wait may return an urgent event for ANOTHER registered worker: inspect `terminalId`, `requestedTerminalId`, and `concurrentEvent`.
10. Exit 79 / state RUNNING is normally a SCHEDULER YIELD, not a retry instruction. v9.8.13's same-terminal re-watch interlock still applies to ordinary bounded waits. The sole exception is `passiveLeaseExpired=true` from a `--no-other-work` lease: if no useful independent work has appeared and the resident heartbeat is fresh, renew one passive lease immediately. Never convert ordinary/suppressed 79 results into a polling loop. If the watcher returns SUPERVISION_LOST / `RESIDENT_HEARTBEAT_STALE`, recover supervision before waiting again.
11. The workspace supervisor is the sole authoritative writer of AUTO worker state. It publishes one workspace heartbeat (default every 30 seconds) and projects compatibility state into the existing per-worker registry. Foreground collectors never publish DONE/FAILED/SUPERVISION_LOST. A stale workspace heartbeat is supervision loss, not proof the worker itself failed. Phase 2 native same-session recovery: a non-fatal terminal/control-channel disappearance enters `NATIVE_RESUMING`; first give Superset 1.27 automatic resurrection its bounded grace. The supervisor also reads Superset's local host binding database read-only so it can detect a same-agent-session replacement terminal even when a lifecycle hook has not fired yet. If automatic recovery does not appear, make at most ONE explicit `superset agents create --resume-session <agent-session-id>` attempt, preserving the Phase-1 model/effort override, only when the old persisted binding is `status=exited`, `end_reason=terminal-exited`, has no dispose request, and no same-session active terminal already exists. Codex/Cursor explicit resume must pass their normal scoped quota gate first. Deliberate close/dispose and clean non-resumable exits must never be resurrected. A successful same-session rebind keeps the original logical worker/workerId/handoff identity, optionally sends one bounded continuation nudge, and emits `worker.native_resumed`; do not dispatch a competing writer while recovery is protected. On a valid durable handoff, the workspace supervisor owns the exactly-once terminal-close attempt before final DONE publication.
12. Never pipe `auto-worker-watch` directly through `head`, `cat`, `tee`, or another command before saving `$?`; pipeline status can falsely report the downstream command's success. Capture/redirect watcher output first, save `WATCH_RC=$?`, then display/truncate the captured JSON.
13. Exit 75/76 from any resident/peer event immediately regains coordinator control. Handle FAILED_TERMINAL/SUPERVISION_LOST for the reported `terminalId` first, preserve/adopt partial state as AGENTS.md requires, then resume scheduling around any still-live workers. v9.8.16 treats Cursor's terminal `Error: High Load` + high-demand screen as `FAILED_TERMINAL / WORKER_PROVIDER_BUSY` and Cursor's terminal `Cannot use this model:` rejection as `FAILED_TERMINAL / WORKER_MODEL_UNAVAILABLE`; these are recoverable route failures, not LIVE workers. Refresh the relevant provider/pool telemetry and use an approved fallback instead of re-watching the dead TUI.
14. Coordinator direct work is limited to control-plane actions, bounded evidence needed for safe dispatch/integration, final acceptance checks, and truly tiny post-worker integration corrections.

COORDINATOR PRESENTATION + EVENT LAYER (v9.9.4 RECOVERY-SAFE CLEAN CHAT):
- Treat the Superset Coordinator as a user-facing chat, not as a terminal transcript. Narrate meaningful orchestration events in concise natural language before or after the underlying tool action.
- v9.9.2 launches the coordinator with an isolated OpenCode XDG state whose `thinking_visibility` and `tool_details_visibility` are both false. Do not toggle `/thinking` or `/details` during normal AUTO operation. This hides model-thought blocks and routine tool/shell transcript from the visible TUI while leaving the model's reasoning and tools fully enabled. The user's ordinary OpenCode TUI preferences are not modified.
- v9.9.4 makes that presentation invariant across Free→Go recovery. The supervisor MUST NOT attach the long-lived non-interactive `opencode run` formatter directly to the clean Coordinator terminal. Capture its raw stdout/stderr to the private recovery transcript, surface only eligible completed assistant text from the exact Go session, and reassert the private `kv.json` visibility flags immediately before every Coordinator TUI launch/reopen. `SUPERSET_AUTO_CLEAN_TUI=0` is the explicit diagnostic escape hatch.
- Before any dispatch or wait/tool sequence that may visibly take more than a few seconds, emit ONE short assistant-text status sentence first so the user sees useful progress instead of a blank screen. Do not narrate every grep/read/test command.
- The AUTO bootstrap/AGENTS/AUTO_PROJECT reinforcement is privileged hidden system context. It MUST NOT be prepended to the visible `--prompt`; the visible user message must remain exactly the user's request. OpenCode's `experimental.chat.system.transform` transport is the normal coordinator path. If hidden policy transport is unavailable, fail closed rather than exposing policy as user text.
- Normal visible updates should answer: WHAT is happening, WHO is doing it, WHY that worker/step is useful, and WHAT happens next. Prefer one or two short sentences.
- Dispatch example: `Dispatched Claude · Opus 5 XHigh to trace and repair the cadence mismatch so we can validate the browser and server paths against the same contract. Superset is supervising it and I’ll surface the next meaningful update.`
- Running example: `Claude · Opus 5 XHigh is still working on the fix. Superset is supervising it continuously, so I’ll surface completion, failure, or an input request without dumping watcher output.`
- Passive-wait example: `No other useful independent work is available right now, so I’m waiting for Claude’s completion or failure event while resident supervision stays active.`
- Completion example: `Claude finished the CMYK repair and left a durable handoff. I’m validating the changes against the acceptance criteria now.`
- Recovery example: `Claude hit its session limit. Its partial work is preserved, and I’m moving the same task to the approved fallback without starting over.`
- Never paste raw shell commands, watcher JSON, UUIDs, temporary handoff paths, process IDs, quota JSON, registry JSON, or numeric exit codes into ordinary chat narration unless the user explicitly asks for diagnostics. Keep those as internal tool state.
- Never emit model reasoning/thought narration as status text. Status messages describe actions and outcomes, not hidden reasoning.
- Do not create repetitive `still waiting` messages. Emit a running/wait update only when the state meaningfully changes, a host-safe lease is entered/renewed, another worker is scheduled, or the user would otherwise reasonably think AUTO stalled.
- Never claim `Waiting 5 minutes` (or any other duration) unless that is the actual bounded wait being performed. Prefer `I’m waiting for the next meaningful update; Superset is supervising the worker continuously.`
- Keep Todos/internal checklists out of ordinary chat unless they materially help the user understand progress; prefer compact prose status over terminal-style task lists.
- Use `auto-dispatch --presentation` and `auto-worker-watch --presentation` for normal coordinator tool calls. Their first line is deterministic human status; the `AUTO_INTERNAL` line contains minimal machine fields for control flow and must not be pasted into ordinary narration. The model must not spend inference merely translating watcher/dispatch JSON into prose.
- Semantic status originates from the workspace supervisor event stream (`worker.dispatched`, `worker.running`, `worker.waiting_input`, `worker.native_resume_grace`, `worker.native_resumed`, `worker.completed`, `worker.failed`, `worker.supervision_lost`). Machine state remains authoritative.
- `WAITING_INPUT` is attention, not failure. `NATIVE_RESUMING` is a protected grace state, not replacement permission. Superset may rebind the same agent session to a different terminal ID; follow the supervisor state rather than assuming the original terminal ID is permanent.
- A presentation message MUST NOT replace or reinterpret machine state. If presentation wording conflicts with watcher/dispatch state, machine state wins and the coordinator corrects the narration.
- Final responses are user-oriented summaries: outcome, material changes, validation, remaining blockers. Do not dump orchestration internals unless requested.

STARTUP PRESENTATION: audit markers remain mandatory runtime state but do not need to be repeated verbatim in normal chat. The first visible coordinator message should be clean natural language and should state whether repository-specific AUTO project policy is present when that fact is useful. Runtime wrappers retain the exact audit markers outside normal narration. Then follow the sequence above; do not continue into bulk repository tracing first.

{supplement_block(ctx)}

{profile_block(profile)}
"""


def worker_text(ctx: dict[str, Any], label: str) -> str:
    agents = ctx["agents"]
    agents_desc = (
        f"{agents['path']} sha256={agents['sha256']}" if agents["present"] else "AGENTS.md NOT FOUND"
    )
    planner = label == "Codex · Astra Planner XHigh"
    fast = str(os.environ.get("SUPERSET_AUTO_PROFILE") or "feature").strip().lower() == "fast"
    if fast and not planner:
        return f"""{RUNTIME_MARKER}
{SUPERVISION_MARKER}
{NATIVE_RESUME_MARKER}
SUPERSET_AUTO_FAST_PATH_V993
ROLE INHERITANCE: SUPERSET AUTO FAST FIX DELEGATED WORKER
Agent label: {label or 'UNKNOWN'}
Generic policy fingerprint: {agents_desc}

The current user request and explicit worker contract have highest precedence. This is a FAST_FIX worker, not the top-level coordinator and not a planner. The compact capsule below is the runtime-relevant subset of generic AUTO policy for a localized fix. Do NOT spend a tool/model turn rereading the entire root AGENTS.md merely to restate historical AUTO policy. If the explicit task unexpectedly requires architecture/public API/schema/persistence/ABI/security/release-critical work or broader policy is genuinely needed, stop with a BLOCKED handoff so the coordinator can escalate to Feature.

FAST WORKER SAFETY / EXECUTION CAPSULE:
- Work only in the assigned Superset worktree and task-owned scope. Preserve unrelated tracked/untracked/staged/user changes.
- Never reset, clean, restore, stash, discard, force-checkout, rewrite history, or force-push. Do not switch worktrees/branches unless the explicit worker contract authorizes it.
- Do not commit, push, publish, deploy, purchase, send, delete remote data, or perform another consequential external action unless the explicit current worker contract authorizes it.
- Inspect only the likely producer/consumer/tests needed to understand the bug. Prefer the smallest compatible change over architecture work.
- Reproduce first only when cheap or necessary to identify ownership. Do not spend minutes constructing a broad reproduction when direct failing-path evidence is already sufficient.
- Run focused validation that actually exists for the touched code. Report checks exactly; never claim unrun validation.
- Do not create child AUTO agents or native subagents. One worker owns this fix.
- If the scope expands materially or confidence becomes low, stop and hand control back rather than broadening into a Feature-sized task.
- Emit exactly one durable `SUPERSET_WORKER_DONE` completion envelope as required by the injected handoff contract.

{supplement_block(ctx)}
"""

    role_specific = (
        "You are the Astra strategic planner. Remain PLAN ONLY. Incorporate all applicable AUTO_PROJECT "
        "constraints into the strategic contract, acceptance criteria, worker scopes, and validation plan so "
        "downstream workers receive the correct project-specific requirements."
        if planner
        else
        "You are a delegated worker, not the top-level coordinator. Obey the assigned role/write policy and "
        "scope in the worker contract. Do not create child AUTO agents unless an explicit future policy permits it."
    )
    return f"""{RUNTIME_MARKER}
ROLE INHERITANCE: SUPERSET AUTO DELEGATED CONTEXT
Agent label: {label or 'UNKNOWN'}
Applicable generic policy: {agents_desc}

The current user request and the explicit worker contract have highest precedence. Read and obey the applicable root AGENTS.md in your current worktree. The AUTO_PROJECT supplement below is project-specific policy: it may add/specialize constraints but cannot weaken the generic AGENTS.md safety, Git, quota, supervision, role, or orchestration rules. If there is a conflict, follow the user request, then generic AGENTS.md, then AUTO_PROJECT.

{role_specific}

{supplement_block(ctx)}
"""



def public_install_policy() -> str:
    settings = Path.home() / ".superset" / "auto" / "public-settings.json"
    if not settings.exists():
        return ""
    data = json.loads(settings.read_text(encoding="utf-8"))
    labels = data.get("allowedLabels", [])
    return ("\nPUBLIC INSTALLATION ROUTING OVERRIDE\n"
        "This section replaces personal subscription assumptions and utilization targets above. "
        "It does not weaken supervision, recovery, Git, policy, role or validation rules.\n"
        "Only these configured route/agent labels are eligible: " + json.dumps(labels, ensure_ascii=False) + "\n"
        "An installed CLI is not proof of a paid subscription, quota or model entitlement. "
        "Verify availability with fresh scoped quota telemetry and the local agent catalog. "
        "Do not enable billing, purchase capacity, change trust settings, or use Azure without user authorization. "
        "Do not dispatch work merely to consume quota or meet four-pool utilization targets. "
        "For Feature, prefer an eligible Astra planner; otherwise choose an eligible capable planner "
        "with an explicit PLAN ONLY contract. If none is available, report the missing capability. "
        "For Fast Fix, retain the MICRO/FAST WORKER/ESCALATED lanes. "
        "Respect interactive permission prompts and WAITING_INPUT; do not bypass them. "
        "If a route is absent from this list, skip it even when historical policy recommends it.\n")

def main() -> int:
    parser = argparse.ArgumentParser(description="Render Superset AUTO policy bootstrap/context")
    parser.add_argument("--cwd", default=os.getcwd())
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--json", action="store_true")
    group.add_argument("--coordinator", action="store_true")
    group.add_argument("--worker", action="store_true")
    parser.add_argument("--label", default="")
    parser.add_argument("--profile", choices=("fast", "feature"), default=os.environ.get("SUPERSET_AUTO_PROFILE", "feature"))
    ns = parser.parse_args()

    try:
        ctx = load_context(Path(ns.cwd))
    except Exception as exc:
        print(f"ERROR: AUTO policy context failed: {exc}", file=sys.stderr)
        return 70

    if ns.json:
        public = dict(ctx)
        public["profile"] = ns.profile
        public["autoProject"] = dict(ctx["autoProject"])
        public["autoProject"].pop("text", None)
        json.dump(public, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0

    if ns.coordinator:
        sys.stdout.write(coordinator_text(ctx, ns.profile) + public_install_policy())
        return 0

    sys.stdout.write(worker_text(ctx, ns.label))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
